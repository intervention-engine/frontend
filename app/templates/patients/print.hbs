<table class="table table-striped">
<thead>
  <tr class="th-no-bottom">
    <th colspan="3">&nbsp;</th>
    <th colspan="3" class="text-center th-border-bottom">Next Huddle</th>
    <th>&nbsp;</th>
  </tr>
  <tr class="th-no-top">
    <th>Patient Name</th>
    <th>Gender</th>
    <th>Age</th>
    <th>Date</th>
    <th>Reason</th>
    <th>Reviewed</th>
    <th>Risk</th>
  </tr>
</thead>
<tbody>
  {{#each model.patients as |patient|}}
    {{patient-print-badge patient=patient huddles=(patient-huddles model.huddles patient) assessment=currentAssessment}}
  {{/each}}
</tbody>
</table>

<div class="text-center">
  <button class="hide-in-print btn btn-primary" onclick={{action 'print'}}>Print</button>
  <button class="hide-in-print btn btn-ie-lg btn-default" onclick={{action 'closeWindow'}}>Close Window</button>
</div>
