<dl class="dl-horizontal">
  <dt>Risk Assessment:</dt>
  <dd>{{assessment}}</dd>
  {{#if model.group}}
    <dt>Population:</dt>
    <dd>{{model.group.name}}</dd>
  {{/if}}
  {{#if huddleId}}
    <dt>Huddle:</dt>
    <dd>Geriatrics Huddle ({{moment-format currentHuddle.date 'll'}})</dd>
  {{/if}}
  {{#if name}}
    <dt>Patient Name Search:</dt>
    <dd>{{name}}</dd>
  {{/if}}
  <dt>Sort By:</dt>
  <dd>{{sortByDisplayText}}</dd>
</dl>

<div class="text-center">
  <button class="hide-in-print btn btn-primary" onclick={{action 'print'}}>Print</button>
  <button class="hide-in-print btn btn-ie-lg btn-default" onclick={{action 'closeWindow'}}>Close Window</button>
</div>

<table class="table table-striped">
<thead>
  <tr class="th-no-bottom">
    <th colspan="3">&nbsp;</th>
    <th colspan="3" class="text-center th-border-bottom">Next Huddle</th>
    <th>&nbsp;</th>
  </tr>
  <tr class="th-no-top">
    <th>Patient Name</th>
    <th>Gender</th>
    <th>Age</th>
    <th>Date</th>
    <th>Reason</th>
    <th>Reviewed</th>
    <th>Risk</th>
  </tr>
</thead>
<tbody>
  {{#each model.patients as |patient|}}
    {{patient-print-badge patient=patient huddles=(patient-huddles model.huddles patient) riskAssessment=(get risksByPatient patient.id)}}
  {{/each}}
</tbody>
</table>

<div class="text-center">
  <button class="hide-in-print btn btn-primary" onclick={{action 'print'}}>Print</button>
  <button class="hide-in-print btn btn-ie-lg btn-default" onclick={{action 'closeWindow'}}>Close Window</button>
</div>
